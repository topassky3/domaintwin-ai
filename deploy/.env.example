# Public hostname served by Caddy. Point its A/AAAA record at the VPS first.
DOMAIN_TWIN_HOST=domaintwin.example.com

# Django runtime
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=backend,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://domaintwin.example.com
DJANGO_SECURE_COOKIES=1
DJANGO_SESSION_COOKIE_AGE_SECONDS=1209600
DJANGO_DB_TIMEOUT_SECONDS=20
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT_SECONDS=30

# name.com sandbox. Credentials remain backend/worker only.
NAMECOM_ENVIRONMENT=sandbox
NAMECOM_USERNAME=your-namecom-username
NAMECOM_API_TOKEN=your-sandbox-api-token
NAMECOM_TIMEOUT_SECONDS=10

# Recovery is armed only for the sandbox hackathon drill.
NAMECOM_ALLOW_MUTATIONS=1
NAMECOM_ALLOW_PRODUCTION_MUTATIONS=0
# Optional emergency-domain registration drill. Enable only when intentionally demoing Gate 8.
NAMECOM_ALLOW_DOMAIN_REGISTRATION=0

# Monitoring Lite
DOMAIN_HEALTH_TIMEOUT_SECONDS=4
DOMAIN_MONITOR_INTERVAL_SECONDS=60

# AI explanation is optional; deterministic detection/recovery does not depend on it.
AI_PROVIDER=disabled
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=700
