DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# name.com Core API
# sandbox uses https://api.dev.name.com and requires the sandbox token.
# You may set NAMECOM_USERNAME to the normal account username; DomainTwin appends -test in sandbox.
NAMECOM_ENVIRONMENT=sandbox
NAMECOM_USERNAME=your-namecom-username
NAMECOM_API_TOKEN=your-sandbox-api-token
NAMECOM_TIMEOUT_SECONDS=10

# Mutating DNS is opt-in even in sandbox.
NAMECOM_ALLOW_MUTATIONS=0
# Keep production mutations disabled during hackathon development.
NAMECOM_ALLOW_PRODUCTION_MUTATIONS=0

# HTTP/HTTPS availability probes.
DOMAIN_HEALTH_TIMEOUT_SECONDS=4
